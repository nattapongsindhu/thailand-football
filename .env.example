# Optional PostgreSQL mode. Without DATABASE_URL the app runs read-only local preview.
# Never commit real credentials.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Render supplies PORT automatically. When PORT is present the app binds
# HOST:PORT (default HOST=0.0.0.0). Without PORT it uses 127.0.0.1:8080-8089.
# PORT=10000
# HOST=0.0.0.0

# Local preview snapshot path (used only when DATABASE_URL is absent).
TF_SEED_PATH=data/seed.json

# Team registry file loaded in both preview and PostgreSQL modes.
TF_TEAM_REGISTRY=data/team_registry.json

# Logging.
RUST_LOG=thailand_football=info,tower_http=info
